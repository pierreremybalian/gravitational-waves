---
// The series-wide corner tag: a quiet link to the contact page on balian.dev, bottom-right on every demo.
---

<a class="hire" href="https://balian.dev/contact/" target="_blank" rel="noopener">Hire Me</a>

<style>
  .hire {
    position: fixed;
    z-index: 40;
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    padding: 0.28rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-mute);
    background: rgb(8 8 16 / 0.6);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .hire:hover {
    color: var(--color-paper);
    border-color: var(--color-line-strong);
  }
  .hire:focus-visible {
    outline: 2px solid var(--color-l1);
    outline-offset: 3px;
    color: var(--color-paper);
  }
  :global(html.clean) .hire {
    display: none;
  }
  @media print {
    .hire {
      display: none;
    }
  }
</style>
