---
// Stages 4–6: where in the slowed chirp the sound (and the picture) is. The clip's data window, the merger, and a
// playhead on the audio clock (the same clipClock the scene reads), so it is clear the loop plays on its own and the
// scroll does not drive it.
---

<div class="card tl" data-tl>
  <h3>Chirp clip <span>data time</span></h3>
  <div class="bar">
    <div class="track"></div>
    <div class="fill" data-tl-fill></div>
    <div class="merger" data-tl-merger><i></i><b>merger</b></div>
    <div class="head" data-tl-head></div>
  </div>
  <div class="ends">
    <span data-tl-from></span>
    <span class="now" data-tl-now></span>
    <span data-tl-to></span>
  </div>
  <p class="loop" data-tl-note></p>
</div>

<script>
  import { onStage, showCard } from '../card.ts';
  import { transport } from '../../audio/transport.ts';
  import { clipClock, createClipClock } from '../../shared/space/clock.ts';
  import { loopNote, SLOW_BINARY, SLOW_INSPIRAL, SLOW_MERGER, windowLabel, type SlowChirpSpec } from '../../script/slow.ts';

  const SPECS: Record<string, SlowChirpSpec> = { binary: SLOW_BINARY, inspiral: SLOW_INSPIRAL, merger: SLOW_MERGER };
  const card = document.querySelector<HTMLElement>('[data-tl]')!;
  const q = <T extends HTMLElement>(s: string) => card.querySelector<T>(s)!;
  const el = { mergerText: q('[data-tl-merger] b'), note: q('[data-tl-note]'), fill: q('[data-tl-fill]'), merger: q('[data-tl-merger]'), head: q('[data-tl-head]'), from: q('[data-tl-from]'), to: q('[data-tl-to]'), now: q('[data-tl-now]') };
  const clock = createClipClock();
  let spec: SlowChirpSpec | null = null;
  let raf = 0;
  let shown = '';
  const slowEnd = (s: SlowChirpSpec) => (s.to - s.from) * s.slow;

  function setSpec(s: SlowChirpSpec) {
    spec = s;
    el.note.textContent = loopNote(s);
    el.from.textContent = windowLabel(s, s.from);
    // The merger: a tick inside the window, or an arrow past its end (stage 4 stops 0.6 s before it).
    const inside = s.from < 0 && s.to > 0;
    el.merger.classList.toggle('past', !inside);
    el.merger.style.left = inside ? `${((0 - s.from) / (s.to - s.from)) * 100}%` : '100%';
    el.mergerText.textContent = inside ? 'merger' : `merger ${Math.abs(s.to).toFixed(1)} s on →`;
    el.to.textContent = windowLabel(s, s.to);
    shown = '';
  }

  function draw() {
    raf = requestAnimationFrame(draw);
    if (!spec) return;
    clipClock(transport.frameOut, spec, clock, 0.25, false);
    const u = Math.min(1, Math.max(0, (clock.t - spec.from) / (spec.to - spec.from)));
    el.head.style.transform = `translateX(${(u * 100).toFixed(2)}cqw)`;
    el.fill.style.transform = `scaleX(${u.toFixed(4)})`;
    card.style.setProperty('--tl-dip', clock.dip.toFixed(3));
    const txt = !clock.live ? 'starts after the last chirp' : clock.pos >= slowEnd(spec) ? 'gap · loops' : windowLabel(spec, clock.t);
    if (txt !== shown) {
      shown = txt;
      el.now.textContent = txt;
    }
  }

  onStage((s) => {
    const sp = SPECS[s.stageId];
    const on = !!sp && s.local > 0.06 && s.local < 0.985;
    if (sp && sp !== spec) setSpec(sp);
    showCard(card, on);
    if (on && !raf) raf = requestAnimationFrame(draw);
    else if (!on && raf) {
      cancelAnimationFrame(raf);
      raf = 0;
    }
  });
</script>

<style>
  .tl {
    --tl-dip: 1;
  }
  /* Desktop: low, left of the sound and Hire Me buttons, under the binary the scenes frame right of centre. */
  @media (min-width: 768px) {
    :global(.hud) .card.tl {
      bottom: max(1rem, 2.2svh);
      right: calc(max(1.5rem, 4vw) + 8rem);
      width: 20rem;
      padding: 0.7rem 0.9rem 0.6rem;
    }
  }
  .bar {
    position: relative;
    height: 1.6rem;
    margin: 0.75rem 0 0.35rem;
    container-type: inline-size;
  }
  .track,
  .fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
  }
  .track {
    background: var(--color-line-strong);
  }
  .fill {
    background: linear-gradient(90deg, rgb(173 151 255 / 0.25), var(--color-light));
    transform-origin: left center;
    transform: scaleX(0);
    opacity: calc(0.35 + 0.65 * var(--tl-dip));
  }
  .merger {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }
  .merger i {
    position: absolute;
    top: 0.1rem;
    bottom: 0.1rem;
    left: -0.5px;
    width: 1px;
    background: var(--color-paper);
    opacity: 0.8;
  }
  .merger.past i {
    display: none;
  }
  .merger.past b {
    transform: translateX(-100%);
    color: var(--color-mute);
  }
  .merger b {
    position: absolute;
    bottom: 100%;
    left: 0;
    transform: translateX(-50%);
    font: 500 0.58rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-paper);
    white-space: nowrap;
  }
  .head {
    position: absolute;
    left: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 10px 2px rgb(173 151 255 / 0.8);
    opacity: calc(0.3 + 0.7 * var(--tl-dip));
  }
  .ends {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font: 0.62rem/1.3 var(--font-mono);
    color: var(--color-mute);
    font-variant-numeric: tabular-nums;
  }
  .ends .now {
    color: var(--color-light);
  }
  .loop {
    margin-top: 0.35rem;
    font: 0.62rem/1.3 var(--font-mono);
    color: var(--color-fog);
  }
  /* Phones: a slim strip in the free corner left of the sound and Hire Me buttons, under the captions and clear of
     the scene's waveform at the top. The loop note sits between the window's ends; the playhead shows "now". */
  @media (max-width: 767px) {
    :global(.hud) .card.tl {
      top: auto;
      bottom: max(0.5rem, env(safe-area-inset-bottom));
      left: 0.75rem;
      right: auto;
      width: calc(100vw - 9.4rem);
      padding: 0.15rem 0.5rem 0.25rem;
      border-radius: 0.6rem;
    }
    :global(.hud) .card.tl h3,
    .ends .now {
      display: none;
    }
    .bar {
      height: 0.9rem;
      margin: 0.5rem 0 0;
    }
    .merger b {
      font-size: 0.48rem;
    }
    .ends,
    .loop {
      font-size: 0.48rem;
    }
    .loop {
      position: absolute;
      left: 50%;
      bottom: 0.25rem;
      margin: 0;
      transform: translateX(-50%);
      white-space: nowrap;
      color: var(--color-mute);
    }
  }
</style>
