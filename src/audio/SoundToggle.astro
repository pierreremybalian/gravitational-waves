---
// The sound switch: a fixed button (aria-pressed, M key) and the hero's call to action. Sound starts only from a
// click, tap or key press (autoplay rules); a stored "on" arms the switch so the next gesture starts it.
---

<button type="button" class="sound" data-sound aria-pressed="false" aria-label="Sound" title="Sound (M)">
  <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
    <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" fill="currentColor"></path>
    <g class="waves" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M15.2 9.2a4 4 0 0 1 0 5.6"></path>
      <path d="M17.6 6.8a7.4 7.4 0 0 1 0 10.4"></path>
    </g>
    <path class="mute" d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <span class="label" data-sound-label>Sound off</span>
</button>

<script>
  import { transport } from './transport.ts';
  import { $sound } from '../state/sound.ts';

  const btn = document.querySelector<HTMLButtonElement>('[data-sound]')!;
  const label = btn.querySelector<HTMLElement>('[data-sound-label]')!;
  const ctas = document.querySelectorAll<HTMLButtonElement>('[data-sound-cta]');

  const toggle = () => ($sound.get() === 'on' || $sound.get() === 'starting' ? transport.disableSound() : transport.enableSound());
  btn.addEventListener('click', toggle);
  ctas.forEach((b) => b.addEventListener('click', () => ($sound.get() === 'on' ? undefined : transport.enableSound())));

  const TEXT = { off: 'Sound off', armed: 'Tap for sound', starting: 'Starting…', on: 'Sound on', blocked: 'Tap to resume sound' } as const;
  $sound.subscribe((s) => {
    btn.dataset.state = s;
    btn.setAttribute('aria-pressed', s === 'on' ? 'true' : 'false');
    label.textContent = TEXT[s];
    ctas.forEach((b) => (b.textContent = s === 'on' ? 'Sound is on' : s === 'armed' ? 'Tap to start sound' : 'Turn sound on'));
  });

  // A stored "on" (or a blocked context) starts on the next real gesture anywhere on the page.
  const onGesture = (e: Event) => {
    const s = $sound.get();
    if (s !== 'armed' && s !== 'blocked') return;
    if (e.target instanceof Element && e.target.closest('[data-sound], [data-sound-cta]')) return;
    transport.enableSound();
  };
  for (const type of ['pointerup', 'keydown'] as const) window.addEventListener(type, onGesture, { capture: true });

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'm' && e.key !== 'M') return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.closest('input, textarea, select, [contenteditable]') || t.closest('[data-own-keys]'))) return;
    e.preventDefault();
    toggle();
  });
</script>

<style>
  .sound {
    position: fixed;
    z-index: 40;
    right: max(0.75rem, env(safe-area-inset-right));
    /* Sits just above the Hire Me tag in the corner. */
    bottom: calc(max(0.75rem, env(safe-area-inset-bottom)) + 2.1rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem 0.5rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fog);
    background: rgb(8 8 16 / 0.72);
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .sound:hover,
  .sound:focus-visible {
    color: var(--color-paper);
    border-color: var(--color-fog);
  }
  .sound:focus-visible {
    outline: 2px solid var(--color-l1);
    outline-offset: 3px;
  }
  .sound .waves {
    display: none;
  }
  .sound[data-state='on'] .waves {
    display: inline;
  }
  .sound[data-state='on'] .mute {
    display: none;
  }
  .sound[data-state='on'] {
    color: var(--color-h1);
    border-color: color-mix(in srgb, var(--color-h1) 60%, transparent);
  }
  .sound[data-state='armed'],
  .sound[data-state='blocked'] {
    color: var(--color-h1);
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(255 179 92 / 0);
    }
    50% {
      box-shadow: 0 0 0 6px rgb(255 179 92 / 0.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound[data-state='armed'],
    .sound[data-state='blocked'] {
      animation: none;
    }
  }
  @media (max-width: 520px) {
    .sound .label {
      display: none;
    }
    /* One row with the Hire Me tag, to its left. */
    .sound {
      padding: 0.6rem;
      right: calc(max(0.75rem, env(safe-area-inset-right)) + 6rem);
      bottom: calc(max(0.75rem, env(safe-area-inset-bottom)) - 0.45rem);
    }
  }
  :global(html.clean) .sound {
    display: none;
  }
</style>
